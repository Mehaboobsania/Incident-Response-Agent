# ==============================================================================
# Incident Response Agent (IRA) — LLM Configuration
# ==============================================================================
# Add your API key below. You can use EITHER Google Gemini OR OpenAI (or compatible).

# --- Option 1: Google Gemini (Recommended) ---
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional model override (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# --- Option 2: OpenAI / OpenAI-Compatible (Groq, DeepSeek, Ollama, OpenRouter) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
